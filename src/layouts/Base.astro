---
import '../styles/global.css';
import { useT, href, withBase, type Locale, LOCALES } from '../i18n';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  /** chemin sans préfixe de langue, pour le sélecteur de langue et hreflang */
  path?: string;
}
const { lang, title, description, path = '' } = Astro.props;
const t = useT(lang);
const other: Locale = lang === 'fr' ? 'en' : 'fr';
const fullTitle = title ? `${title} · KEU DIRU` : `KEU DIRU — ${t('site.tagline')}`;
const desc = description ?? t('site.description');
const isDemo = !import.meta.env.PUBLIC_SUPABASE_URL;
const current = Astro.url.pathname;
const nav = [
  { path: '/explore', key: 'nav.explore' },
  { path: '/collections', key: 'nav.collections' },
  { path: '/paths', key: 'nav.paths' },
  { path: '/contribute', key: 'nav.contribute' },
] as const;
const isActive = (p: string) => current.startsWith(href(lang, p).replace(/index\.html$/, ''));
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url);
const canonical = new URL(href(lang, path), siteRoot).href;
const preview = import.meta.env.PUBLIC_PREVIEW_FILE_LINKS === '1';
const depth = Astro.url.pathname.replace(/index\.html$/, '').split('/').filter(Boolean).length;
const previewBase = depth ? '../'.repeat(depth) : './';
// chemin de la page courante relatif à <base> (le lien d'évitement « #main » seul viserait la racine)
const rawPath = Astro.url.pathname.replace(/^\/+/, '').replace(/^404\/?$/, '404.html'); // 404 = fichier racine
const selfPath = rawPath === '' || rawPath.endsWith('/') ? `${rawPath}index.html` : rawPath.endsWith('.html') ? rawPath : `${rawPath}.html`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preview && <base href={previewBase} />}
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, path), siteRoot).href} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#9f3f1a" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/icons/icon-192.png')} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href={preview ? `${selfPath}#main` : '#main'} class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 btn btn-primary z-50">{t('nav.skip')}</a>
    {isDemo && (
      <div class="bg-indigo text-white text-sm text-center py-1.5 px-4" role="note">{t('demo.banner')}</div>
    )}
    <header class="border-b border-line bg-paper/95 backdrop-blur sticky top-0 z-40">
      <div class="container-k flex items-center gap-4 h-16">
        <a href={href(lang)} class="flex items-baseline gap-2 no-underline shrink-0" aria-label="KEU DIRU — accueil">
          <span class="font-serif text-2xl font-bold tracking-tight">KEU&nbsp;DIRU</span>
        </a>
        <nav aria-label="Principal" class="hidden md:flex items-center gap-1 ml-4">
          {nav.map((n) => (
            <a href={href(lang, n.path)} class:list={['px-3 py-2 rounded-md text-[0.95rem] no-underline hover:bg-accent-soft', isActive(n.path) && 'text-accent font-semibold']} aria-current={isActive(n.path) ? 'page' : undefined}>{t(n.key)}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <a href={href(lang, '/dashboard')} class="btn btn-ghost !py-1.5 !min-h-[40px] text-sm">{t('nav.dashboard')}</a>
          <a href={href(other, path)} hreflang={other} lang={other} class="text-sm px-2 py-2 underline">{t('nav.switch')}</a>
        </div>
      </div>
      <nav aria-label="Mobile" class="md:hidden border-t border-line overflow-x-auto">
        <div class="container-k flex gap-1 py-1">
          {nav.map((n) => (
            <a href={href(lang, n.path)} class:list={['px-3 py-2 text-sm whitespace-nowrap no-underline rounded-md', isActive(n.path) && 'text-accent font-semibold bg-accent-soft']}>{t(n.key)}</a>
          ))}
        </div>
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line mt-16 py-8 text-sm text-muted">
      <div class="container-k flex flex-col md:flex-row gap-3 md:items-center justify-between">
        <p class="max-w-2xl">{t('footer.license')}</p>
        <div class="flex gap-4">
          <a href={href(lang, '/about')}>{t('nav.about')}</a>
          <a href="https://github.com/krazymapper/Keu-Diru" rel="noopener">{t('footer.source')}</a>
        </div>
      </div>
    </footer>
    <script>
      // Service worker : production uniquement (en dev il masquerait les modifications).
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}/sw.js`, { scope: `${base}/` }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
