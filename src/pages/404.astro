---
import Base from '../layouts/Base.astro';
import { useT, href } from '../i18n';
const t = useT('fr');
const te = useT('en');
---
<Base lang="fr" title={t('404.title')}>
  <div class="container-k py-24 text-center">
    <p class="font-serif text-7xl text-accent mb-4">404</p>
    <h1 class="text-3xl mb-2">{t('404.title')}</h1>
    <p class="text-muted mb-1">{t('404.lead')}</p>
    <p class="text-muted mb-8" lang="en">{te('404.lead')}</p>
    <a href={href('fr')} class="btn btn-primary">Accueil</a>
    <a href={href('en')} class="btn btn-ghost ml-2" lang="en">Home</a>
  </div>
</Base>
