---
import Base from '../../layouts/Base.astro';
import Dashboard from '../../components/Dashboard';
import { getCatalog, label } from '../../lib/catalog';
import { useT, localeStaticPaths, type Locale } from '../../i18n';
export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const c = await getCatalog();
const paths = c.learning_paths.map((p) => ({ slug: p.slug, title: label(p.title, lang), total: p.steps.length }));
---
<Base lang={lang} title={t('dash.title')} path="/dashboard">
  <div class="container-k py-10">
    <h1 class="text-3xl md:text-4xl mb-3">{t('dash.title')}</h1>
    <p class="text-muted mb-8 max-w-2xl">{t('dash.lead')}</p>
    <Dashboard client:load lang={lang} paths={paths} />
  </div>
</Base>
