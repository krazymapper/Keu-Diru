---
import Base from '../../../layouts/Base.astro';
import { getCatalog, label } from '../../../lib/catalog';
import { useT, href, localeStaticPaths, type Locale } from '../../../i18n';
export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const c = await getCatalog();
---
<Base lang={lang} title={t('paths.title')} path="/paths">
  <div class="container-k py-10">
    <h1 class="text-3xl md:text-4xl mb-3">{t('paths.title')}</h1>
    <p class="text-muted mb-8">{t('paths.lead')}</p>
    <ul class="grid md:grid-cols-2 gap-4">
      {c.learning_paths.map((p) => (
        <li><a href={href(lang, `/paths/${p.slug}`)} class="card p-6 block no-underline hover:border-ink border-l-4 !border-l-accent h-full">
          <span class="font-serif text-2xl font-semibold block mb-2">{label(p.title, lang)}</span>
          <span class="text-muted block">{label(p.objective, lang)}</span>
          <span class="flex gap-2 mt-4"><span class="chip">{t('common.steps', { n: p.steps.length })}</span><span class="chip">{t(`level.${p.level}`)}</span></span>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
