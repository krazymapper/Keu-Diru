---
import Base from '../../../layouts/Base.astro';
import PathProgress from '../../../components/PathProgress';
import { getCatalog, label, pickTranslation } from '../../../lib/catalog';
import { useT, href, LOCALES, type Locale } from '../../../i18n';
export async function getStaticPaths() {
  const c = await getCatalog();
  return LOCALES.flatMap((lang) => c.learning_paths.map((p) => ({ params: { lang, slug: p.slug } })));
}
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const c = await getCatalog();
const p = c.learning_paths.find((x) => x.slug === Astro.params.slug)!;
const steps = p.steps.map((s, i) => {
  const r = s.resource ? c.resources.find((x) => x.slug === s.resource) : undefined;
  return { index: i + 1, slug: r?.slug ?? null, title: r ? pickTranslation(r, lang).title : null, instruction: s.instruction ? label(s.instruction, lang) : null };
});
---
<Base lang={lang} title={label(p.title, lang)} description={label(p.objective, lang)} path={`/paths/${p.slug}`}>
  <div class="container-k py-10 max-w-3xl">
    <a href={href(lang, '/paths')} class="text-sm text-muted">← {t('paths.title')}</a>
    <h1 class="text-3xl md:text-5xl mt-4 mb-4">{label(p.title, lang)}</h1>
    <div class="card p-5 mb-8 bg-accent-soft border-accent/30">
      <p class="eyebrow mb-1">{t('paths.objective')}</p>
      <p class="text-lg">{label(p.objective, lang)}</p>
    </div>
    <PathProgress client:load path={p.slug} steps={steps} lang={lang} />
  </div>
</Base>
