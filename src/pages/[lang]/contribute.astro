---
import Base from '../../layouts/Base.astro';
import ContributeForm from '../../components/ContributeForm';
import { getCatalog, label } from '../../lib/catalog';
import { useT, localeStaticPaths, type Locale } from '../../i18n';
export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const c = await getCatalog();
---
<Base lang={lang} title={t('contribute.title')} path="/contribute">
  <div class="container-k py-10 max-w-3xl">
    <h1 class="text-3xl md:text-4xl mb-3">{t('contribute.title')}</h1>
    <p class="text-muted mb-8">{t('contribute.lead')}</p>
    <ContributeForm client:load lang={lang} repoUrl="https://github.com/krazymapper/Keu-Diru"
      types={c.resource_types.map((x) => ({ slug: x.slug, label: label(x.labels, lang) }))}
      disciplines={c.disciplines.map((x) => ({ slug: x.slug, label: label(x.labels, lang) }))}
      languages={c.languages.map(({ code, native_name }) => ({ code, native_name }))} />
  </div>
</Base>
