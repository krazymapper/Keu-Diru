---
import Base from '../../../layouts/Base.astro';
import { getCatalog, label } from '../../../lib/catalog';
import { useT, href, localeStaticPaths, type Locale } from '../../../i18n';
export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const c = await getCatalog();
---
<Base lang={lang} title={t('collections.title')} path="/collections">
  <div class="container-k py-10">
    <h1 class="text-3xl md:text-4xl mb-3">{t('collections.title')}</h1>
    <p class="text-muted mb-8 max-w-2xl">{t('collections.lead')}</p>
    <ul class="grid md:grid-cols-2 gap-4">
      {c.collections.map((col) => (
        <li><a href={href(lang, `/collections/${col.slug}`)} class="card p-6 block no-underline hover:border-ink h-full">
          <span class="font-serif text-2xl font-semibold block mb-2">{label(col.title, lang)}</span>
          <span class="text-muted block">{label(col.description, lang)}</span>
          <span class="chip mt-4">{t('common.resources', { n: col.items.length })}</span>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
