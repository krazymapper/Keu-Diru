---
import Base from '../../layouts/Base.astro';
import Explorer from '../../components/Explorer';
import { useT, localeStaticPaths, type Locale } from '../../i18n';
export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = useT(lang);
---
<Base lang={lang} title={t('explore.title')} path="/explore">
  <div class="container-k py-10">
    <h1 class="text-3xl md:text-4xl mb-8">{t('explore.title')}</h1>
    <Explorer client:load lang={lang} />
    <noscript><p class="card p-4 mt-4">JavaScript est nécessaire pour filtrer. / JavaScript is required for filtering.</p></noscript>
  </div>
</Base>
