# Copier en .env — ne JAMAIS y mettre la clé service_role (RM-16).
# Vides => le site utilise data/seed/*.json (mode démonstration).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# 1 => le build échoue si Supabase est injoignable au lieu de retomber sur le seed
KEU_STRICT_DATA=
# Déploiement
SITE_URL=https://krazymapper.github.io
BASE_PATH=/Keu-Diru
